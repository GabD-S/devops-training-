<% content_for :title, "Todos" %>

<div class="hero">
  <p class="hero-kicker"><%= Date.current.strftime("%d.%m.%Y") %></p>
  <h1>Modo <span>foco</span></h1>
  <p>Sem enrolação. O que entra aqui, sai feito.</p>
</div>

<div class="card">
  <%= form_with(model: Todo.new, url: todos_path, class: "new-todo") do |form| %>
    <%= form.text_field :title, placeholder: "O que precisa ser feito?", required: true, autocomplete: "off" %>
    <%= form.submit "Adicionar", class: "btn btn-primary" %>
  <% end %>
</div>

<% if @todos.any? %>
  <% done = @todos.count(&:completed?) %>
  <div class="stats">
    <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="<%= @todos.size %>" aria-valuenow="<%= done %>">
      <div class="progress-bar" style="width: <%= (done.to_f / @todos.size * 100).round %>%"></div>
    </div>
    <span><%= done %>/<%= @todos.size %> concluídas</span>
  </div>

  <div id="todos" class="todo-list">
    <% @todos.each do |todo| %>
      <%= render todo %>
    <% end %>
  </div>
<% else %>
  <div class="empty card">
    <span class="empty-icon">🌑</span>
    <strong>Zerou a lista.</strong>
    Primeira tarefa aí em cima.
  </div>
<% end %>
